# Enhanced DocParser Configuration

# Application Settings
APP_NAME="Enhanced Document Parser"
DEBUG=false
SECRET_KEY="your-secret-key-here"

# OpenAI Configuration - Enhanced Models
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="gpt-4o"
OPENAI_VISION_MODEL="gpt-4o"
OPENAI_REASONING_MODEL="o1-preview"
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_DELAY=1.0
OPENAI_TIMEOUT=60
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.1

# Advanced AI Features
USE_STRUCTURED_OUTPUTS=true
ENABLE_MULTI_MODAL_ANALYSIS=true
USE_REASONING_MODEL_FOR_COMPLEX_DOCS=false
ENABLE_CONTEXTUAL_UNDERSTANDING=true

# Document Type Specific Models
SCIENTIFIC_PAPER_MODEL="gpt-4o"
FINANCIAL_REPORT_MODEL="gpt-4o"
TECHNICAL_MANUAL_MODEL="gpt-4o"
LEGAL_DOCUMENT_MODEL="gpt-4o"

# OCR and Image Processing
OCR_FALLBACK_ENABLED=true
TESSERACT_PATH=""
EXTRACT_TABLES_FROM_IMAGES_ENABLED=true
AI_PROCESSOR_IMAGE_BATCH_SIZE=3

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# Database
DATABASE_URL="sqlite:///./enhanced_docparser.db"

# File Upload Settings
MAX_UPLOAD_SIZE=10485760  # 10MB
MAX_FILES_PER_UPLOAD=5
ALLOWED_FILE_TYPES=".pdf,.docx,.txt,.md,.doc,.pptx,.xlsx"

# Directories
TEMP_DIR="./temp"
UPLOAD_DIR="./uploads"
MARKDOWN_DIR="./markdown"

# CORS Settings
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Logging
LOG_LEVEL="INFO"
LOG_FILE="logs/enhanced_app.log"
